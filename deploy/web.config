<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for the Triathlon web application.

  `dotnet publish` generates its own web.config; this file is the reference for what the published
  one must end up containing, and the one to copy over the site when a setting has to be changed by
  hand on the server. Replace Triathlon.Web.dll only if the assembly is ever renamed.

  In-process hosting: the application runs inside the IIS worker process, which is roughly twice as
  fast as out-of-process for this workload and means there is no second Kestrel port to firewall.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\Triathlon.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Everything secret (connection string, seed administrator, SMTP, staging password)
               belongs in the site's own environment variables, set in IIS Manager or by the
               deployment script — never here, because this file is in source control. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!-- The media store accepts uploads up to 25 MB; IIS's own request ceiling has to allow it. -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="26214400" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
