@page "/dashboard"
@using System.Security.Claims
@inject IStringLocalizer<DashboardStrings> L

<PageTitle>@L["Overview"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h4" GutterBottom="true">@L["Overview"]</MudText>
        <MudText Typo="Typo.body1">@L["WelcomeBody", context.User.Identity?.Name ?? ""]</MudText>
        <MudText Typo="Typo.body2" Class="mt-2">@L["Roles"]: @RoleList(context)</MudText>
    </Authorized>
</AuthorizeView>

@code {
    private static string RoleList(AuthenticationState state)
    {
        var roles = state.User.FindAll(ClaimTypes.Role).Select(claim => claim.Value).ToArray();
        return roles.Length == 0 ? "none" : string.Join(", ", roles);
    }
}
