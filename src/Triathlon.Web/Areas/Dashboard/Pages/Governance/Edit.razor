@page "/dashboard/governance/new"
@page "/dashboard/governance/{Id:guid}"
@attribute [Authorize(Policy = Policies.Content)]
@using Triathlon.Web.Domain.Content
@inject DashboardScope Scope
@inject IStringLocalizer<DashboardStrings> L
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService Dialogs

<PageTitle>@title</PageTitle>

<EditShell @key="@Id" Title="@title" BackHref="dashboard/governance" IsNew="@(Id is null)" IsPublished="@model.IsPublished" IsDirty="@dirty" IsSaving="@saving"
           Error="@error" FieldErrors="@fieldErrors" LastUpdatedAt="@loaded?.UpdatedAt" LastUpdatedBy="@loaded?.UpdatedBy"
           OnSaveDraft="@(() => SaveAsync(publish: false))" OnPublish="@(() => SaveAsync(publish: true))" OnUnpublish="@UnpublishAsync" OnDelete="@DeleteAsync"
           ActivityEntity="Committee" ActivityId="@Id">

    <BilingualField Label="@L["Kind"]" Name="Kind" En="@model.KindEn" EnChanged="@(v => { model.KindEn = v; dirty = true; })"
                     Ar="@model.KindAr" ArChanged="@(v => { model.KindAr = v; dirty = true; })" />
    <BilingualField Label="@L["Name"]" Name="Name" En="@model.NameEn" EnChanged="@(v => { model.NameEn = v; dirty = true; })"
                     Ar="@model.NameAr" ArChanged="@(v => { model.NameAr = v; dirty = true; })" />
    <BilingualField Label="@L["Description"]" Name="Description" Lines="3" En="@model.DescriptionEn" EnChanged="@(v => { model.DescriptionEn = v; dirty = true; })"
                     Ar="@model.DescriptionAr" ArChanged="@(v => { model.DescriptionAr = v; dirty = true; })" />
    <MudNumericField T="int" Label="@L["SortOrder"]" Value="@model.SortOrder" ValueChanged="@(v => { model.SortOrder = v; dirty = true; })" Class="mt-4" />
</EditShell>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private sealed class Model
    {
        public string? KindEn { get; set; }
        public string? KindAr { get; set; }
        public string? NameEn { get; set; }
        public string? NameAr { get; set; }
        public string? DescriptionEn { get; set; }
        public string? DescriptionAr { get; set; }
        public int SortOrder { get; set; }
        public bool IsPublished { get; set; } = true;

        public static Model From(Committee c) => new()
        {
            KindEn = c.KindEn, KindAr = c.KindAr, NameEn = c.NameEn, NameAr = c.NameAr,
            DescriptionEn = c.DescriptionEn, DescriptionAr = c.DescriptionAr,
            SortOrder = c.SortOrder, IsPublished = c.IsPublished,
        };

        public CommitteeInput ToInput(Guid? id, bool published) => new(
            id, KindEn ?? "", KindAr ?? "", NameEn ?? "", NameAr ?? "", DescriptionEn ?? "", DescriptionAr ?? "", SortOrder, published);
    }

    private Model model = new();
    private Committee? loaded;
    private bool dirty;
    private bool saving;
    private string? error;
    private readonly Dictionary<string, string> fieldErrors = new(StringComparer.Ordinal);

    private string title => Id is null ? L["NewCommittee"] : (loaded is null ? "" : loaded.NameEn);

    protected override async Task OnParametersSetAsync()
    {
        if (Id is { } id)
        {
            var all = await Scope.RunAsync(sp => sp.GetRequiredService<ContentService>().CommitteesForEditAsync(false, CancellationToken.None));
            loaded = all.FirstOrDefault(c => c.Id == id);
            if (loaded is null)
            {
                Nav.NavigateTo("dashboard/not-found");
                return;
            }

            model = Model.From(loaded);
        }

        dirty = false;
    }

    private async Task SaveAsync(bool publish)
    {
        saving = true;
        error = null;
        fieldErrors.Clear();
        try
        {
            var published = publish || (loaded?.IsPublished ?? false);
            var input = model.ToInput(Id, published);
            var saved = await Scope.RunAsync(sp => sp.GetRequiredService<ContentService>().SaveCommitteeAsync(input, CancellationToken.None));
            if (Id is null)
            {
                Snackbar.Add(publish ? L["PublishedToast"] : L["Saved"], Severity.Success);
                Nav.NavigateTo($"dashboard/governance/{saved.Id}");
                return;
            }

            loaded = saved;
            model = Model.From(loaded);
            dirty = false;
            Snackbar.Add(publish ? L["PublishedToast"] : L["Saved"], Severity.Success);
        }
        catch (ContentValidationException ex)
        {
            EditShell.Handle(L, ex, out error, fieldErrors);
            Snackbar.Add(L["ErrorSaving"], Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task UnpublishAsync()
    {
        if (Id is not { } id || loaded is null)
        {
            return;
        }

        saving = true;
        error = null;
        fieldErrors.Clear();
        try
        {
            var input = Model.From(loaded).ToInput(id, false);
            loaded = await Scope.RunAsync(sp => sp.GetRequiredService<ContentService>().SaveCommitteeAsync(input, CancellationToken.None));
            model = Model.From(loaded);
            Snackbar.Add(L["Saved"], Severity.Success);
        }
        catch (ContentValidationException ex)
        {
            EditShell.Handle(L, ex, out error, fieldErrors);
            Snackbar.Add(L["ErrorSaving"], Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (Id is not { } id || loaded is null)
        {
            return;
        }

        if (!await ConfirmDialog.ShowAsync(Dialogs, L["Delete"], L["DeleteCommitteeConfirm"], L["Delete"], danger: true, typeToConfirm: loaded.NameEn))
        {
            return;
        }

        saving = true;
        error = null;
        fieldErrors.Clear();
        try
        {
            await Scope.RunAsync(sp => sp.GetRequiredService<ContentService>().DeleteCommitteeAsync(id, CancellationToken.None));
            Snackbar.Add(L["Saved"], Severity.Success);
            Nav.NavigateTo("dashboard/governance");
        }
        catch (ContentValidationException ex)
        {
            EditShell.Handle(L, ex, out error, fieldErrors);
            Snackbar.Add(L["ErrorSaving"], Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }
}
