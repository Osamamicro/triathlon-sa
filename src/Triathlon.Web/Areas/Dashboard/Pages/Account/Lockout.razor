@page "/dashboard/lockout"
@layout AuthLayout
@attribute [AllowAnonymous]

@using Microsoft.Extensions.Localization

@inject IStringLocalizer<DashboardStrings> L

<PageTitle>@L["LockedOutTitle"]</PageTitle>

<h1>@L["LockedOutTitle"]</h1>
<p role="alert">@L["LockedOutBody"]</p>

<p><a href="dashboard/login">@L["BackToDashboard"]</a></p>
