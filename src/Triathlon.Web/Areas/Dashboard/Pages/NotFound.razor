@page "/dashboard/not-found"
@layout AuthLayout
@attribute [AllowAnonymous]

@using Microsoft.Extensions.Localization

@inject IStringLocalizer<DashboardStrings> L

<PageTitle>@L["NotFoundTitle"]</PageTitle>

<h1>@L["NotFoundTitle"]</h1>
<p>@L["NotFoundBody"]</p>

<p><a href="dashboard">@L["BackToDashboard"]</a></p>
