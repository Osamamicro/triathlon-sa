@page "/dashboard/error"
@layout AuthLayout
@attribute [AllowAnonymous]
@using System.Diagnostics
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<DashboardStrings> L

<PageTitle>@L["ErrorTitle"]</PageTitle>

<h1>@L["ErrorTitle"]</h1>
<p>@L["ErrorBody"]</p>

@if (!string.IsNullOrEmpty(requestId))
{
    <p class="muted">Reference: <code>@requestId</code></p>
}

<p><a href="dashboard">@L["BackToDashboard"]</a></p>

@code {
    private string? requestId;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized() => requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
