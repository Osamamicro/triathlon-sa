@* The shared media library, opened from MediaPicker: pick an existing upload, or add a new one. *@
@using Microsoft.AspNetCore.Components.Forms
@inject DashboardScope Scope
@inject IStringLocalizer<DashboardStrings> L
@inject ILogger<EditShell> Logger

<MudDialog>
    <DialogContent>
        @if (loading)
        {
            <MudProgressCircular Indeterminate="true" Class="ma-4" />
        }
        else
        {
            <MudGrid>
                @foreach (var asset in items)
                {
                    <MudItem xs="4" sm="3" md="2">
                        <MudPaper Class="pa-1 stf-media-tile" @onclick="@(() => Select(asset))" Elevation="0" Outlined="true">
                            @if (asset.Kind == FileKind.Image)
                            {
                                <MudImage Src="@asset.Path" Alt="@asset.OriginalFileName" Fluid="true" ObjectFit="ObjectFit.Cover" Height="80" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Large" />
                            }
                            <MudText Typo="Typo.caption" Class="d-block text-truncate">@asset.OriginalFileName</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            @if (items.Count == 0)
            {
                <MudText Color="Color.Secondary" Class="my-2">@L["NoMedia"]</MudText>
            }
            else if (pageCount > 1)
            {
                <MudPagination Count="@pageCount" Selected="@pageNumber" SelectedChanged="OnPageChangedAsync" Class="my-2" />
            }

            <MudDivider Class="my-3" />

            <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelectedAsync" Accept="@Accept">
                <CustomContent Context="picker">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload"
                               Disabled="@uploading" OnClick="@picker.OpenFilePickerAsync">
                        @(uploading ? L["Uploading"] : L["Upload"])
                    </MudButton>
                </CustomContent>
            </MudFileUpload>

            @if (error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@error</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public FileKind Kind { get; set; }

    private const int PageSize = 24;

    private List<MediaAsset> items = [];
    private bool loading = true;
    private bool uploading;
    private string? error;
    private int pageNumber = 1;
    private int total;

    private string Accept => Kind == FileKind.Image ? "image/*" : ".pdf";
    private int pageCount => Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            var result = await Scope.RunAsync(sp => sp.GetRequiredService<MediaService>().ListAsync(Kind, false, (pageNumber - 1) * PageSize, PageSize, CancellationToken.None));
            items = [.. result.Items];
            total = result.Total;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnPageChangedAsync(int value)
    {
        pageNumber = value;
        await LoadAsync();
    }

    private async Task OnFileSelectedAsync(IBrowserFile file)
    {
        if (file is null)
        {
            return;
        }

        error = null;

        // OpenReadStream(maxAllowedSize) below throws IOException synchronously the moment the
        // browser-reported size is over the limit — checked here first so the common case shows an
        // inline error instead of ever reaching that throw.
        if (file.Size > LocalFileStore.MaxBytes)
        {
            error = L["Validation_File", OverLimitText];
            return;
        }

        uploading = true;
        try
        {
            await using var stream = file.OpenReadStream(LocalFileStore.MaxBytes);
            var asset = await Scope.RunAsync(sp => sp.GetRequiredService<MediaService>().UploadAsync(stream, file.Name, Kind, null, null, CancellationToken.None));
            items.Insert(0, asset);
        }
        catch (ContentValidationException ex)
        {
            error = L[ex.Key, [.. ex.Arguments]];
        }
        catch (IOException)
        {
            // Belt-and-suspenders for the Size check above: a stale/misreported Size, or a stream
            // that grows mid-read, must still surface as an inline error rather than kill the circuit.
            error = L["Validation_File", OverLimitText];
        }
        catch (DbUpdateException ex)
        {
            // Same circuit-safety net as every EditShell-backed save (see EditShell.HandleUnexpected):
            // a column-level constraint the service's own checks missed must not terminate the circuit.
            EditShell.HandleUnexpected(L, ex, Logger, out var banner);
            error = banner;
        }
        finally
        {
            uploading = false;
        }
    }

    private static string OverLimitText => $"> {LocalFileStore.MaxBytes / (1024 * 1024)} MB";

    private void Select(MediaAsset asset) => MudDialog.Close(DialogResult.Ok(asset));

    private void Cancel() => MudDialog.Cancel();
}
