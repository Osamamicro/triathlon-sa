@* A standalone upload control — for a document/rule/guide's own file, as opposed to MediaPicker's
   "choose from the library" flow. Uploads straight into MediaService and hands the caller the
   resulting MediaAsset; the caller decides what to do with its Path. *@
@using Microsoft.AspNetCore.Components.Forms
@inject MediaService MediaService
@inject IStringLocalizer<DashboardStrings> L

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
    <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelectedAsync" Accept="@Accept">
        <CustomContent Context="picker">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload"
                       Disabled="@uploading" OnClick="@picker.OpenFilePickerAsync">
                @(uploading ? L["Uploading"] : L["Upload"])
            </MudButton>
        </CustomContent>
    </MudFileUpload>

    @if (uploading)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
    }
</MudStack>

@if ((error ?? ServerError) is { } message)
{
    <MudText Color="Color.Error" Typo="Typo.caption">@message</MudText>
}

@code {
    [Parameter, EditorRequired]
    public FileKind Kind { get; set; }

    [Parameter]
    public EventCallback<MediaAsset> OnUploaded { get; set; }

    [Parameter]
    public string Accept { get; set; } = "";

    [Parameter]
    public long MaxBytes { get; set; } = LocalFileStore.MaxBytes;

    /// <summary>This field's name for a refused save's <see cref="FieldErrors"/> lookup.</summary>
    [Parameter]
    public string? Name { get; set; }

    /// <summary>Field name to localized message, cascaded from the enclosing <c>EditShell</c>.</summary>
    [CascadingParameter(Name = "FieldErrors")]
    public IReadOnlyDictionary<string, string>? FieldErrors { get; set; }

    private string? ServerError => Name is null ? null : FieldErrors?.GetValueOrDefault(Name);

    private bool uploading;
    private string? error;

    private async Task OnFileSelectedAsync(IBrowserFile file)
    {
        if (file is null)
        {
            return;
        }

        error = null;

        // OpenReadStream(maxAllowedSize) below throws IOException synchronously the moment the
        // browser-reported size is over the limit — checked here first so the common case shows an
        // inline error instead of ever reaching that throw.
        if (file.Size > MaxBytes)
        {
            error = L["Validation_File", OverLimitText];
            return;
        }

        uploading = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxBytes);
            var asset = await MediaService.UploadAsync(stream, file.Name, Kind, null, null, CancellationToken.None);
            await OnUploaded.InvokeAsync(asset);
        }
        catch (ContentValidationException ex)
        {
            error = L[ex.Key, [.. ex.Arguments]];
        }
        catch (IOException)
        {
            // Belt-and-suspenders for the Size check above: a stale/misreported Size, or a stream
            // that grows mid-read, must still surface as an inline error rather than kill the circuit.
            error = L["Validation_File", OverLimitText];
        }
        finally
        {
            uploading = false;
        }
    }

    private string OverLimitText => $"> {MaxBytes / (1024 * 1024)} MB";
}
