@* The slug for a page, event, news post, rule or guide. Left alone, it tracks the English title
   through Slugs' one formatting rule; typed into once, it stops following the title. *@
@using System.Text.RegularExpressions
@using Triathlon.Web.Areas.Public
@using Triathlon.Web.Domain.Common
@inject IStringLocalizer<DashboardStrings> L

<MudTextField T="string"
              Label="@(Label ?? L["Slug"])"
              Value="@Value"
              ValueChanged="OnChangedAsync"
              Error="@hasError"
              ErrorText="@errorText"
              Class="@Class"
              OnBlur="@((FocusEventArgs _) => touched = true)" />

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>The English title this slug is derived from until the user types one of their own.</summary>
    [Parameter]
    public string? Source { get; set; }

    /// <summary>Overrides the default "Slug" label — e.g. Cities' Key field applies the same slug rule.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// This field's name for a refused save's <see cref="FieldErrors"/> lookup. Defaults to
    /// <c>"Slug"</c>, matching the field name every other slug-shaped save throws under; Cities'
    /// Key field passes <c>Name="Key"</c> since that is what <c>SaveCityAsync</c> actually throws.
    /// </summary>
    [Parameter]
    public string? Name { get; set; }

    /// <summary>Field name to localized message, cascaded from the enclosing <c>EditShell</c>.</summary>
    [CascadingParameter(Name = "FieldErrors")]
    public IReadOnlyDictionary<string, string>? FieldErrors { get; set; }

    /// <summary>Passed through to the underlying <c>MudTextField</c>.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Whether a value in <see cref="PublicSite.ReservedSlugs"/> (minus <see cref="PublicSite.CompanionPageSlugs"/>)
    /// is flagged as <c>SlugReserved</c>. Defaults to true for top-level content such as pages;
    /// event, news and guide slugs live under their own URL segment and can never collide with a
    /// reserved top-level route, so those screens pass <c>false</c> and only the format check applies.
    /// </summary>
    [Parameter]
    public bool Reserved { get; set; } = true;

    private bool userTyped;
    private bool touched;

    protected override async Task OnParametersSetAsync()
    {
        if (userTyped || !string.IsNullOrEmpty(Value) || string.IsNullOrWhiteSpace(Source))
        {
            return;
        }

        var derived = Derive(Source);
        if (!string.IsNullOrEmpty(derived) && derived != Value)
        {
            Value = derived;
            await ValueChanged.InvokeAsync(Value);
        }
    }

    private async Task OnChangedAsync(string? value)
    {
        userTyped = true;
        touched = true;
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    // Not a [GeneratedRegex]: the source generator that backs it only sees the original syntax
    // trees in a compilation pass, and a .razor file's @code block is emitted by the Razor
    // generator itself — one generator's output is invisible to another, so the partial method it
    // needs never gets its implementation.
    private static readonly Regex NonSlugPattern = new("[^a-z0-9]+", RegexOptions.CultureInvariant | RegexOptions.Compiled);

    private static string Derive(string source)
    {
        var lowered = source.Trim().ToLowerInvariant();
        var withHyphens = NonSlugPattern.Replace(lowered, "-");
        return withHyphens.Trim('-');
    }

    private bool IsReserved(string? slug) =>
        Reserved
        && !string.IsNullOrEmpty(slug)
        && PublicSite.ReservedSlugs.Contains(slug)
        && !PublicSite.CompanionPageSlugs.Contains(slug);

    private string? ServerError => FieldErrors?.GetValueOrDefault(Name ?? "Slug");

    private bool hasError => ServerError is not null || (touched && !string.IsNullOrEmpty(Value) && (!Slugs.IsValid(Value) || IsReserved(Value)));

    private string? errorText => ServerError ?? (IsReserved(Value) ? L["SlugReserved"] : L["SlugInvalid"]);
}
