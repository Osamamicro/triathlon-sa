@page "/register/received"
@model RegisterReceivedModel
@{
    var culture = PublicCulture.Of(ViewContext);
}

  <section class="page-hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow">@Bi("Application received", "تم استلام الطلب")</span>
      <h1>@(string.IsNullOrWhiteSpace(Model.Name)
            ? Bi("Thank you", "شكراً لك")
            : Bi("Thank you, ", "شكراً لك، ") + Model.Name)</h1>
      <p class="hero-lead">@Bi("Your registration is with the membership desk. A confirmation is on its way to the address you gave us.",
                              "طلب تسجيلك لدى إدارة العضويات. وصلك بريد تأكيد على العنوان الذي أدخلته.")</p>
    </div>
  </section>

  <section class="section" style="padding-top:8px">
    <div class="container">
      <div class="license-card" style="max-width:640px">
        <span class="eyebrow">@Bi("What happens next", "ماذا بعد؟")</span>
        <ul class="list-check" style="margin-top:14px">
          <li>@Bi("An officer reviews your application within five working days.", "يراجع موظف مختص طلبك خلال خمسة أيام عمل.")</li>
          <li>@Bi("Your licence number arrives by email once the application is approved.", "يصلك رقم رخصتك بالبريد الإلكتروني بعد اعتماد الطلب.")</li>
          <li>@Bi("A licensed athlete can enter any sanctioned race in the Kingdom.", "الرياضي المرخص يسجل في أي سباق معتمد في المملكة.")</li>
        </ul>
      </div>
      <div class="hero-actions" style="margin-top:22px">
        <a class="btn btn-primary" href="@PublicCulture.Url(culture, "events")">@Bi("Find your first race", "اعثر على سباقك الأول")</a>
        <a class="btn btn-ghost" href="@PublicCulture.Url(culture, "training")">@Bi("Start training", "ابدأ التدريب")</a>
      </div>
    </div>
  </section>
