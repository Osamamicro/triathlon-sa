@page
@model IndexModel
@{
    var culture = PublicCulture.Of(ViewContext);
}

  <!-- ======================= HERO ======================= -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container">
      <span class="hero-kicker mono">@Bi("National Series 2026–27 · Registration open", "السلسلة الوطنية 2026–27 · التسجيل مفتوح")</span>
      <h1>
        @if (IsArabic)
        {
          <text>اسبح. اركب. اجرِ.<br><span class="grad">نحو الأمام.</span></text>
        }
        else
        {
          <text>Swim. Ride. Run.<br><span class="grad">Forward.</span></text>
        }
      </h1>
      <p class="hero-lead">@Bi("The Saudi Triathlon Federation is the national home of multisport — from your first community aquathlon to the national team. Find your race, join a club, and follow the series across the Kingdom.", "الاتحاد السعودي للترايثلون هو البيت الوطني للرياضات المتعددة — من أول أكواثلون مجتمعي تخوضه وصولاً إلى المنتخب الوطني. اعثر على سباقك، وانضم إلى نادٍ، وتابع السلسلة في جميع مناطق المملكة.")</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="@PublicCulture.Url(culture, "events")">@Bi("Find your race", "اعثر على سباقك")</a>
        <a class="btn btn-ghost" href="@PublicCulture.Url(culture, "join")">@Bi("Become an athlete", "كن رياضياً")</a>
      </div>

      <!-- course line: swim → T1 → bike → T2 → run -->
      <svg class="hero-course" viewBox="0 0 1200 120" aria-hidden="true">
        <path d="M10 70 H1190" stroke="#8CA0B8" opacity=".14" stroke-dasharray="1 7"></path>
        <path class="draw" d="M10 70 q 30 -26 60 0 t 60 0 t 60 0 t 60 0 t 60 0 t 60 0"
              stroke="#26C6E8" opacity=".9"></path>
        <path class="draw d2" d="M400 70 L470 40 L540 88 L610 36 L680 84 L750 48 L790 70"
              stroke="#2EE68A" opacity=".9"></path>
        <path class="draw d3" d="M800 70 h36 m18 0 h36 m18 0 h36 m18 0 h36 m18 0 h36 m18 0 h36 m18 0 h36"
              stroke="#FFA245" opacity=".9"></path>
        <g font-family="IBM Plex Mono,monospace" font-size="15" fill="#5C6E85">
          <text x="396" y="112" text-anchor="middle">T1</text>
          <text x="796" y="112" text-anchor="middle">T2</text>
        </g>
        <circle cx="10" cy="70" r="5" fill="#26C6E8"></circle>
        <circle cx="1190" cy="70" r="5" fill="#FFA245"></circle>
      </svg>

      <div class="tri-strip reveal">
        <div class="tri-leg leg-swim">
          <span class="leg-name">@Bi("Swim", "سباحة")</span>
          <span class="leg-data mono">@Bi("750M – 1500M · OPEN WATER", "750م – 1500م · مياه مفتوحة")</span>
        </div>
        <div class="tri-leg leg-bike">
          <span class="leg-name">@Bi("Bike", "دراجة")</span>
          <span class="leg-data mono">@Bi("20KM – 40KM · CLOSED ROADS", "20كم – 40كم · طرق مغلقة")</span>
        </div>
        <div class="tri-leg leg-run">
          <span class="leg-name">@Bi("Run", "جري")</span>
          <span class="leg-data mono">@Bi("5KM – 10KM · CITY CIRCUITS", "5كم – 10كم · مسارات المدن")</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= STATS BAND ======================= -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">@Bi("Federation in numbers", "الاتحاد بالأرقام")</span>
          <h2>@Bi("A sport growing fast", "رياضة تنمو بسرعة")</h2>
        </div>
        <a class="btn btn-ghost btn-sm" href="@PublicCulture.Url(culture, "statistics")">@Bi("All statistics", "جميع الإحصائيات")</a>
      </div>
      <div class="stat-band">
        <div class="stat reveal">
          <div class="stat-value mono" data-count="1284" data-plus>0<span class="plus">+</span></div>
          <div class="stat-label">@Bi("Registered athletes", "رياضي مسجل")</div>
          <div class="stat-note mono">@Bi("+31% VS 2025", "‎+31% مقارنة بـ2025")</div>
        </div>
        <div class="stat reveal" style="--stat-c:var(--swim)">
          <div class="stat-value mono" data-count="42">0</div>
          <div class="stat-label">@Bi("Elite athletes", "رياضيو النخبة")</div>
          <div class="stat-note mono">@Bi("NATIONAL SQUAD POOL", "قاعدة المنتخب الوطني")</div>
        </div>
        <div class="stat reveal" style="--stat-c:var(--bike)">
          <div class="stat-value mono" data-count="24">0</div>
          <div class="stat-label">@Bi("Tournaments held", "بطولة أقيمت")</div>
          <div class="stat-note mono">@Bi("ACROSS 9 REGIONS", "في 9 مناطق")</div>
        </div>
        <div class="stat reveal" style="--stat-c:var(--run)">
          <div class="stat-value mono" data-count="18650" data-plus>0<span class="plus">+</span></div>
          <div class="stat-label">@Bi("Race participations", "مشاركة في السباقات")</div>
          <div class="stat-note mono">@Bi("SINCE 2023", "منذ 2023")</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= UPCOMING EVENTS ======================= -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">@Bi("Next start lines", "خطوط الانطلاق القادمة")</span>
          <h2>@Bi("Upcoming events", "الفعاليات القادمة")</h2>
        </div>
        <a class="btn btn-ghost btn-sm" href="@PublicCulture.Url(culture, "events")">@Bi("Full calendar", "التقويم الكامل")</a>
      </div>
      <div class="grid grid-3" id="homeEvents"></div>
    </div>
  </section>

  <!-- ======================= SEASON TEASER ======================= -->
  <section class="section">
    <div class="container">
      <div class="cta-banner reveal">
        <div>
          <span class="eyebrow">@Bi("2026–27 season", "موسم 2026–27")</span>
          <h2>@Bi("One season, eight cities", "موسم واحد، ثماني مدن")</h2>
          <p>@Bi("Follow the national series on an interactive timeline and map — from the Red Sea to the Gulf, competition and community side by side.", "تابع السلسلة الوطنية عبر جدول زمني وخريطة تفاعلية — من البحر الأحمر إلى الخليج، بطولاتٍ وفعاليات مجتمعية جنباً إلى جنب.")</p>
        </div>
        <a class="btn btn-primary" href="@PublicCulture.Url(culture, "events/timeline")">@Bi("Explore the season", "استكشف الموسم")</a>
      </div>
    </div>
  </section>

  <!-- ======================= QUICK PATHS ======================= -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">@Bi("For every role", "لكل الأدوار")</span>
          <h2>@Bi("Where do you start?", "من أين تبدأ؟")</h2>
        </div>
      </div>
      <div class="grid grid-4">
        <a class="card hover reveal" href="@PublicCulture.Url(culture, "join")">
          <span class="eyebrow">@Bi("Athletes", "الرياضيون")</span>
          <h3>@Bi("Join the federation", "الانضمام إلى الاتحاد")</h3>
          <p class="muted" style="font-size:.92rem">@Bi("Registration steps, categories, clubs — and the pathway to the national team.", "خطوات التسجيل والفئات والأندية — والمسار نحو المنتخب الوطني.")</p>
        </a>
        <a class="card hover reveal" href="@PublicCulture.Url(culture, "training")">
          <span class="eyebrow">@Bi("Beginners", "المبتدئون")</span>
          <h3>@Bi("Training guide", "دليل التدريب")</h3>
          <p class="muted" style="font-size:.92rem">@Bi("From zero to your first sprint in 12 weeks, one discipline at a time.", "من الصفر إلى أول سباق قصير خلال 12 أسبوعاً، رياضةً تلو الأخرى.")</p>
        </a>
        <a class="card hover reveal" href="@PublicCulture.Url(culture, "rules")">
          <span class="eyebrow">@Bi("Officials & organizers", "الحكام والمنظمون")</span>
          <h3>@Bi("Rules & regulations", "اللوائح والأنظمة")</h3>
          <p class="muted" style="font-size:.92rem">@Bi("Competition rules, organizer manuals and officiating handbooks — all downloadable.", "قوانين المنافسات وأدلة المنظمين والحكام — جميعها قابلة للتحميل.")</p>
        </a>
        <a class="card hover reveal" href="@PublicCulture.Url(culture, "governance")">
          <span class="eyebrow">@Bi("Media & partners", "الإعلام والشركاء")</span>
          <h3>@Bi("Governance & transparency", "الحوكمة والشفافية")</h3>
          <p class="muted" style="font-size:.92rem">@Bi("Annual reports, financial statements and board minutes in one documents library.", "التقارير السنوية والقوائم المالية ومحاضر مجلس الإدارة في مكتبة مستندات واحدة.")</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ======================= FINAL CTA ======================= -->
  <section class="section">
    <div class="container">
      <div class="cta-banner reveal">
        <div>
          <h2>@Bi("Ready for your first start line?", "جاهز لأول خط انطلاق؟")</h2>
          <p>@Bi("No racing background needed. Community events welcome every level — and every distance has a first-timer wave.", "لا تحتاج إلى خلفية تنافسية. الفعاليات المجتمعية ترحب بجميع المستويات — ولكل مسافة دفعة مخصصة للمبتدئين.")</p>
        </div>
        <div class="hero-actions" style="margin:0">
          <a class="btn btn-primary" href="@PublicCulture.Url(culture, "register")">@Bi("Register online", "سجّل إلكترونياً")</a>
          <a class="btn btn-ghost" href="@PublicCulture.Url(culture, "training")">@Bi("Training guide", "دليل التدريب")</a>
        </div>
      </div>
    </div>
  </section>

@* Replaced in 2.1.D by server-rendered cards read from the database. Until then the three upcoming
   events still come from wwwroot/js/data.js, which is why this one inline script — and the skipped
   inline-script test that guards it — is still here. *@
@section Scripts {
<script>
  (function () {
    var host = document.getElementById("homeEvents");
    host.innerHTML = STF.upcoming.slice(0, 3).map(function (e) { return STFApp.eventCard(e); }).join("");
  })();
</script>
}
