@page "/error"
@model ErrorModel
<section class="page-hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container">
    <span class="eyebrow mono">500</span>
    <h1>@Bi("Something went wrong", "حدث خطأ ما")</h1>
    <p class="hero-lead">@Bi("The federation has been notified. Please try again in a moment.", "تم إبلاغ الاتحاد. فضلاً حاول مرة أخرى بعد قليل.")</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="@PublicCulture.Url(Culture)">@Bi("Back to home", "العودة إلى الرئيسية")</a>
      <a class="btn btn-ghost" href="@PublicCulture.Url(Culture, "events")">@Bi("Find your race", "اعثر على سباقك")</a>
    </div>
  </div>
</section>
