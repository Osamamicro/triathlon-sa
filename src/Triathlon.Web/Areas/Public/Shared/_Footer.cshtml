@using Triathlon.Web.Domain.Content
@using Triathlon.Web.Services
@inject IStringLocalizer<Shared> L
@inject ContentService Content
@{
    var year = DateTime.UtcNow.Year;

    // The two link columns are rows in the same table the header reads; the contact column stays
    // here because it is the federation's own details rather than site navigation.
    var compete = await Content.NavigationAsync(NavLocation.FooterCompete, Context.RequestAborted);
    var involved = await Content.NavigationAsync(NavLocation.FooterInvolved, Context.RequestAborted);
    var settings = await Content.SettingsAsync(Context.RequestAborted);
    string Setting(string key) => settings.TryGetValue(key, out var s) ? Bi(s.ValueEn, s.ValueAr) : "";
}
<footer class="site-footer">
    <div class="footer-tri"></div>
    <div class="container">
        <div class="footer-grid">
            <div>
                <div class="brand" style="margin-bottom:14px">
                    <img class="brand-mark" src="~/img/brand/stf-mark-96.webp" width="34" height="34" alt="" decoding="async" loading="lazy">
                    <span class="brand-name">@Bi("Saudi Triathlon Federation", "الاتحاد السعودي للترايثلون")</span>
                </div>
                <p class="muted" style="font-size:.9rem;max-width:34ch">
                    @Setting(SettingKeys.FooterBlurb)
                </p>
            </div>
            <div>
                <h2>@Bi("Compete", "المنافسات")</h2>
                <ul>
                    @foreach (var link in compete)
                    {
                        <li><a href="@PublicText.Href(link.Href)">@Bi(link.LabelEn, link.LabelAr)</a></li>
                    }
                </ul>
            </div>
            <div>
                <h2>@Bi("Get involved", "شارك معنا")</h2>
                <ul>
                    @foreach (var link in involved)
                    {
                        <li><a href="@PublicText.Href(link.Href)">@Bi(link.LabelEn, link.LabelAr)</a></li>
                    }
                </ul>
            </div>
            <div>
                <h2>@Bi("Contact", "تواصل معنا")</h2>
                <ul>
                    @{
                        var website = Setting(SettingKeys.ContactWebsite);
                        var email = Setting(SettingKeys.ContactEmail);
                        var x = Setting(SettingKeys.ContactX);
                    }
                    @if (PublicText.IsSafeExternalUrl(website))
                    {
                        <li><a href="@website" rel="noopener">@website.Split("://").Last()</a></li>
                    }
                    @if (email.Length > 0 && email.Contains('@'))
                    {
                        <li><a href="mailto:@email">@email</a></li>
                    }
                    @if (PublicText.IsSafeExternalUrl(x))
                    {
                        <li><a href="@x" rel="noopener">@("@" + x.Split('/').Last())</a></li>
                    }
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <span>@L["FooterLegal", year]</span>
            <a href="/dashboard">@Bi("CONTENT DASHBOARD", "لوحة إدارة المحتوى")</a>
            <span>@Bi("SWIM · BIKE · RUN", "سباحة · دراجة · جري")</span>
        </div>
    </div>
</footer>
