@inject IStringLocalizer<Shared> L
@{
    var culture = PublicCulture.Of(ViewContext);
    var year = DateTime.UtcNow.Year;

    (string Href, string En, string Ar)[] compete =
    [
        (PublicCulture.Url(culture, "events"), "Events & calendar", "الفعاليات والتقويم"),
        (PublicCulture.Url(culture, "events/timeline"), "Season timeline", "الجدول الزمني للموسم"),
        (PublicCulture.Url(culture, "rules"), "Rules & regulations", "اللوائح والأنظمة"),
        (PublicCulture.Url(culture, "statistics"), "Federation statistics", "إحصائيات الاتحاد"),
    ];

    (string Href, string En, string Ar)[] involved =
    [
        (PublicCulture.Url(culture, "register"), "Athlete registration", "تسجيل الرياضيين"),
        (PublicCulture.Url(culture, "join"), "Become an athlete", "كن رياضياً"),
        (PublicCulture.Url(culture, "training"), "Training guide", "دليل التدريب"),
        (PublicCulture.Url(culture, "join") + "#clubs", "Affiliated clubs", "الأندية المنتسبة"),
        (PublicCulture.Url(culture, "governance"), "Governance & transparency", "الحوكمة والشفافية"),
    ];
}
<footer class="site-footer">
    <div class="footer-tri"></div>
    <div class="container">
        <div class="footer-grid">
            <div>
                <div class="brand" style="margin-bottom:14px">
                    <svg class="brand-mark" viewBox="0 0 44 44" aria-hidden="true">
                        <path d="M22 5 L39 37 H33 L22 16 L11 37 H5 Z" fill="none" stroke="url(#triGradFooter)" stroke-width="3.4" stroke-linejoin="round" />
                        <defs>
                            <linearGradient id="triGradFooter" x1="0" y1="0" x2="44" y2="44">
                                <stop offset="0" stop-color="#26C6E8" /><stop offset=".5" stop-color="#2EE68A" /><stop offset="1" stop-color="#FFA245" />
                            </linearGradient>
                        </defs>
                    </svg>
                    <span class="brand-name">@Bi("Saudi Triathlon", "الاتحاد السعودي للترايثلون")</span>
                </div>
                <p class="muted" style="font-size:.9rem;max-width:34ch">
                    @Bi("The national governing body for triathlon, duathlon and aquathlon in the Kingdom of Saudi Arabia.", "الجهة الوطنية المنظمة لرياضات الترايثلون والدواثلون والأكواثلون في المملكة العربية السعودية.")
                </p>
            </div>
            <div>
                <h3>@Bi("Compete", "المنافسات")</h3>
                <ul>
                    @foreach (var link in compete)
                    {
                        <li><a href="@link.Href">@Bi(link.En, link.Ar)</a></li>
                    }
                </ul>
            </div>
            <div>
                <h3>@Bi("Get involved", "شارك معنا")</h3>
                <ul>
                    @foreach (var link in involved)
                    {
                        <li><a href="@link.Href">@Bi(link.En, link.Ar)</a></li>
                    }
                </ul>
            </div>
            <div>
                <h3>@Bi("Contact", "تواصل معنا")</h3>
                <ul>
                    <li><a href="https://triathlon.sa" rel="noopener">triathlon.sa</a></li>
                    <li><a href="mailto:info@@triathlon.sa">info@@triathlon.sa</a></li>
                    <li><a href="https://x.com/TriathlonKSA" rel="noopener">@@TriathlonKSA</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <span>@L["FooterLegal", year]</span>
            <a href="/dashboard">@Bi("CONTENT DASHBOARD", "لوحة إدارة المحتوى")</a>
            <span>@Bi("SWIM · BIKE · RUN", "سباحة · دراجة · جري")</span>
        </div>
    </div>
</footer>
