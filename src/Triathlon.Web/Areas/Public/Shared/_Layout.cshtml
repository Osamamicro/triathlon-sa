@inject IStringLocalizer<Shared> L
@inject IConfiguration Configuration
@{
    // The culture is part of the URL, so the document's language and direction are settled before
    // a byte of the body is written — no client-side flip, no flash of the wrong direction.
    var culture = PublicCulture.Of(ViewContext);
    var isRtl = culture == "ar";
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrWhiteSpace(title) ? L["SiteName"].Value : $"{title} · {L["SiteName"].Value}";
    var ogImage = $"{Context.Request.Scheme}://{Context.Request.Host}/img/og.png";
    var staging = Configuration.GetValue("Site:Staging", false);
}<!doctype html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
@* Synchronous and in <head> on purpose: the stored theme has to be on <html> before the first
   paint, or a light-mode visitor sees a dark flash. External so the CSP can stay script-src 'self'. *@
<script src="~/js/theme.js" asp-append-version="true"></script>
<title>@pageTitle</title>
<meta name="description" content="@L["MetaDescription"]">
@if (staging)
{
    <meta name="robots" content="noindex">
}
<meta property="og:type" content="website">
<meta property="og:site_name" content="@L["SiteName"]">
<meta property="og:locale" content="@(isRtl ? "ar_SA" : "en_US")">
<meta property="og:title" content="@pageTitle">
<meta property="og:description" content="@L["MetaDescription"]">
<meta property="og:image" content="@ogImage">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 44 44'%3E%3Crect width='44' height='44' rx='9' fill='%23060B14'/%3E%3Cpath d='M22 7 L37 36 H31.5 L22 17.5 L12.5 36 H7 Z' fill='none' stroke='%232EE68A' stroke-width='3.4' stroke-linejoin='round'/%3E%3C/svg%3E">
@if (isRtl)
{
<link rel="preload" href="~/fonts/tajawal-700-arabic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="~/fonts/ibm-plex-sans-arabic-400-arabic.woff2" as="font" type="font/woff2" crossorigin>
}
else
{
<link rel="preload" href="~/fonts/rajdhani-700-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="~/fonts/ibm-plex-sans-400-latin.woff2" as="font" type="font/woff2" crossorigin>
}
<link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<a class="skip-link" href="#main">@L["SkipToContent"]</a>
<div class="page-grid" aria-hidden="true"></div>
<partial name="_Header" />

<main id="main">
@RenderBody()
</main>

<partial name="_Footer" />

<script src="~/js/data.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
