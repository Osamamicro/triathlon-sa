@inject IStringLocalizer<Shared> L
@{
    // The culture is part of the URL, so the document's language and direction are settled before
    // a byte of the body is written — no client-side flip, no flash of the wrong direction.
    var culture = PublicCulture.Of(ViewContext);
    var isRtl = culture == "ar";
}<!doctype html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
@* Synchronous and in <head> on purpose: the stored theme has to be on <html> before the first
   paint, or a light-mode visitor sees a dark flash. External so the CSP can stay script-src 'self'. *@
<script src="~/js/theme.js" asp-append-version="true"></script>
<partial name="_Seo" />
@* Icons are the Federation's own mark, rendered on the brand ground. *@
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="180x180" href="/favicon.png">
<link rel="apple-touch-icon" href="/favicon.png">
@if (isRtl)
{
<link rel="preload" href="~/fonts/tajawal-800-arabic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="~/fonts/ibm-plex-sans-arabic-400-arabic.woff2" as="font" type="font/woff2" crossorigin>
}
else
{
<link rel="preload" href="~/fonts/tajawal-800-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="~/fonts/ibm-plex-sans-400-latin.woff2" as="font" type="font/woff2" crossorigin>
}
<link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<a class="skip-link" href="#main">@L["SkipToContent"]</a>
<partial name="_Header" />

<main id="main">
@RenderBody()
</main>

<partial name="_Footer" />

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
