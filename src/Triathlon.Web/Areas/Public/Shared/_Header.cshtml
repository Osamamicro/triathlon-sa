@using Triathlon.Web.Domain.Content
@using Triathlon.Web.Services
@inject IStringLocalizer<Shared> L
@inject ContentService Content
@{
    var culture = PublicCulture.Of(ViewContext);

    // Where we are inside the culture, e.g. "/en/events/timeline" -> "events/timeline".
    var here = (Context.Request.Path.Value ?? string.Empty).Trim('/');
    here = here.Length <= culture.Length ? string.Empty : here[(culture.Length + 1)..];
    if (here.Equals("index", StringComparison.OrdinalIgnoreCase))
    {
        here = string.Empty;
    }

    // Rows, not markup: renaming a section is an edit in the dashboard. Sections shipping in later
    // weeks are already listed; they 404 until they land. Every public page is cached under
    // CacheTags.Site, so a navigation publish evicts the whole site in one call.
    var nav = await Content.NavigationAsync(NavLocation.Header, Context.RequestAborted);

    // Exactly one link is current: the one with the longest href that matches, so "events/timeline"
    // wins over "events" on /en/events/timeline. The home link ("") only matches the home page.
    bool Matches(string path) => path.Length == 0
        ? here.Length == 0
        : here.Equals(path, StringComparison.OrdinalIgnoreCase)
          || here.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);

    var current = nav.Where(item => Matches(item.Href))
        .OrderByDescending(item => item.Href.Length)
        .Select(item => item.Href)
        .FirstOrDefault();

    bool Current(string path) => current is not null && path == current;
}
<header class="site-header"><div class="container">
    @* The Federation's own mark, fetched from triathlon.sa. The anchor's accessible name comes
       from the wordmark beside it, so the image itself is decorative. *@
    <a class="brand" href="@PublicCulture.Url(culture)">
        <img class="brand-mark" src="~/img/brand/stf-mark-96.webp" width="34" height="34" alt="" decoding="async">
        <span class="brand-name">@Bi("Saudi Triathlon", "ترايثلون السعودية")<small>@Bi("Federation", "الاتحاد السعودي")</small></span>
    </a>
    <nav class="main-nav" id="mainNav" aria-label="@L["MainNav"]">
        @foreach (var item in nav)
        {
            <a href="@PublicText.Href(item.Href)" aria-current="@(Current(item.Href) ? "page" : null)">@Bi(item.LabelEn, item.LabelAr)</a>
        }
    </nav>
    <button class="theme-toggle" type="button" aria-label="@L["ThemeToggle"]" data-label-light="@L["SwitchToLight"]" data-label-dark="@L["SwitchToDark"]">
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2v2.4M12 19.6V22M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2 12h2.4M19.6 12H22M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7" /></svg>
    </button>
    @* The toggle is a link to this same page in the other culture, and it is labelled with that
       culture's own name — so it always offers the language you are not currently reading. *@
    <a class="lang-toggle" href="@PublicCulture.SwitchUrl(ViewContext)" lang="@PublicCulture.Other(culture)" aria-label="@L["LanguageToggleAria"]">@L["LanguageToggleLabel"]</a>
    <button class="nav-burger" type="button" aria-expanded="false" aria-controls="mainNav" aria-label="@L["MenuToggle"]">☰</button>
</div></header>
