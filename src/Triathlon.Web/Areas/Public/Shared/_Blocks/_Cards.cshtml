@using Triathlon.Web.Domain.Content
@model PageBlock
@*
    The workhorse block. Variant picks the layout:
      grid-3 (default) · grid-4  — a row of cards, linked when the item carries an href
      pathway                    — the join page's numbered rail of milestones
      muted                      — cards for something not published yet, chipped "In preparation"

    Card bodies are editor-written HTML (the rules cards are checklists), so they go through
    Html.Raw; the Week 4 dashboard sanitises on save.
*@
@{
    var items = Model.Items;
    // Variant is a free string edited through the dashboard; only these four map to a known
    // grid, everything else falls back to the default rather than reaching the class attribute.
    var variant = Model.Variant switch
    {
        "grid-4" => "grid-4",
        "pathway" => "pathway",
        "muted" => "muted",
        _ => "grid-3",
    };
    var isPathway = variant == "pathway";
    var isMuted = variant == "muted";
    var gridClass = isPathway ? "pathway reveal" : $"grid {(isMuted ? "grid-3" : variant)}";

    // The card's contents are the same whether it is a link or not, and only the element differs.
    // The prototype's "in preparation" cards (training.html) lead with the chip, ahead of the
    // eyebrow/title/body — so a muted card renders it first here too.
    void CardBody(string? eyebrow, string? title, string? body)
    {
        if (isMuted)
        {
            <span class="chip">@Bi("In preparation", "قيد الإعداد")</span>
        }
        if (eyebrow is not null)
        {
            <span class="eyebrow">@eyebrow</span>
        }
        if (title is not null)
        {
            <h3>@title</h3>
        }
        if (body is not null)
        {
            if (PublicText.IsBlockHtml(body))
            {
                @Html.Raw(body)
            }
            else
            {
                <p class="muted" style="font-size:.92rem">@Html.Raw(body)</p>
            }
        }
    }
}
<section class="section" id="@Model.Anchor">
    <div class="container">
        <partial name="_Blocks/_SectionHead" model="Model" />
        <div class="@gridClass">
            @foreach (var item in items)
            {
                var eyebrow = item.EyebrowEn is { } eyebrowEn && item.EyebrowAr is { } eyebrowAr ? Bi(eyebrowEn, eyebrowAr) : null;
                var title = item.TitleEn is { } titleEn && item.TitleAr is { } titleAr ? Bi(titleEn, titleAr) : null;
                var body = item.BodyEn is not null || item.BodyAr is not null
                    ? Bi(item.BodyEn ?? string.Empty, item.BodyAr ?? string.Empty)
                    : null;

                var itemAccent = PublicText.AccentVar(item.Color);

                if (isPathway)
                {
                    <div class="path-node">
                        <span class="path-dot">@Digits(eyebrow ?? string.Empty)</span>
                        <h4>@title</h4>
                        @if (body is not null)
                        {
                            <p>@Html.Raw(body)</p>
                        }
                    </div>
                }
                else
                {
                    // An editorial colour becomes a short tab across the card's top inline start —
                    // the same 2px segment the lane rule and the leg strip use — rather than a
                    // full coloured border, which read as decoration rather than as a category.
                    var accentClass = itemAccent is not null ? " has-accent" : string.Empty;
                    var style = itemAccent is not null ? $"--card-c:{itemAccent}" : null;
                    if (isMuted)
                    {
                        style = "opacity:.75;" + style;
                    }

                    if (item.Href is { } href)
                    {
                        <a class="card hover reveal@(accentClass)" style="@style" href="@PublicText.Href(href)">@{ CardBody(eyebrow, title, body); }</a>
                    }
                    else
                    {
                        <div class="card reveal@(accentClass)" style="@style">@{ CardBody(eyebrow, title, body); }</div>
                    }
                }
            }
        </div>
    </div>
</section>
