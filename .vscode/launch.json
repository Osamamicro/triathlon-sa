{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Triathlon.Web (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Triathlon.Web/bin/Debug/net10.0/Triathlon.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Triathlon.Web",
      "stopAtEntry": false,
      "launchSettingsFilePath": "${workspaceFolder}/src/Triathlon.Web/Properties/launchSettings.json",
      "launchSettingsProfile": "https",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/en"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Triathlon.Web (watch, hot reload)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": ["watch", "run", "--launch-profile", "https", "--non-interactive"],
      "cwd": "${workspaceFolder}/src/Triathlon.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "true"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/en"
      },
      "console": "integratedTerminal"
    }
  ]
}
